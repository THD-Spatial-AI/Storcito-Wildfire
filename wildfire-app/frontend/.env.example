# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Self-hosted Cesium quantized-mesh terrain for the 3D view (license-clean — no
# Cesium ion). Served by platform-core/terrain. Leave unset to fall back to the
# smooth ellipsoid (still a 3D perspective, no real elevation).
VITE_CESIUM_TERRAIN_URL=http://localhost:8003/storcito
# Self-hosted Sentinel-2 basemap for the 3D view (STORCITO: make satellite).
VITE_CESIUM_SATELLITE_URL=http://localhost:8003/satellite

# Browser-facing CARTO basemap key.
VITE_CARTO_BASEMAP_API_KEY=

VITE_WORKSHOP_MODE=false
VITE_FEEDBACK_API_URL = http://localhost:3000
# VITE_FEEDBACK_API_URL=https://wildfire.th-deg.de/feedback-api
VITE_WORKSHOP_TOKEN=
VITE_WORKSHOP_TAG=workshop-2026-uvigo
