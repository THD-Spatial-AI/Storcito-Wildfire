cff-version: 1.2.0
title: "STORCITO Wildfire: Wildfire Risk Assessment & Simulation Platform"
message: "If you use this software, please cite it as below."
type: software
authors:
  - family-names: "Khan"
    given-names: "Asim"
    email: "asim.khan@th-deg.de"
    affiliation: "BigGeoData & Spatial AI, Technische Hochschule Deggendorf"
  - family-names: "Miranda Castillo"
    given-names: "Ricardo"
